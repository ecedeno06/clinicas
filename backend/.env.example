# Copiar como .env y completar con los datos reales (no se sube a git)

DATABASE_URL=postgresql://usuario:password@192.168.0.17:5432/clinica_medica
DB_SSL=false

PORT=3001
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4201

# API key de Google restringida a "Geocoding API" unicamente (Google Cloud
# Console -> Credentials). Nunca se expone al frontend -- solo la usa
# geocodificacion.controller.js para traer provincia/distrito de una
# direccion de paciente. Ver DISENO-GEOCODIFICACION-INVERSA.md.
MAPKEY=

# 2FA (TOTP), pista de contrasena y logout por inactividad -- ver
# DISENO-AUTENTICACION-2FA-SESION.md.
# Clave para cifrar usuarios.two_factor_secret (AES-256-CBC): exactamente
# 32 caracteres, o 64 caracteres hexadecimales. Generar con, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_SECRET_KEY=
# % maximo de similitud (Levenshtein) permitido entre la pista y la nueva
# contrasena al guardarla.
PASSWORD_HINT_MAX_SIMILARITY=70
# Minutos de inactividad antes de cerrar la sesion automaticamente, y
# minutos antes de ese cierre en que se muestra el aviso.
SESSION_INACTIVITY_LIMIT_MINUTES=15
SESSION_WARNING_BEFORE_MINUTES=2
