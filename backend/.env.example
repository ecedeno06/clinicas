# Copiar como .env y completar con los datos reales (no se sube a git)

DATABASE_URL=postgresql://usuario:password@192.168.0.17:5432/clinica_medica
DB_SSL=false

PORT=3001
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4201

# API key de Google restringida a "Geocoding API" unicamente (Google Cloud
# Console -> Credentials). Nunca se expone al frontend -- solo la usa
# geocodificacion.controller.js para traer provincia/distrito de una
# direccion de paciente. Ver DISENO-GEOCODIFICACION-INVERSA.md.
MAPKEY=
